# Install to /etc/mjpeg-proxy/mjpeg-proxy.env, owned by root with mode 0600.
# The source URL may contain credentials; this file is read by systemd as root
# and is not readable by the service user.

MJPEG_URL=http://camera.local/stream

# Listen on all interfaces instead of loopback only.
#LISTEN_HOST=0.0.0.0
#LISTEN_PORT=48093
#MAX_ATTEMPTS=5
#RETRY_INTERVAL=2500
#SOURCE_TIMEOUT=10000

# Maximum concurrent viewers. 0 means unlimited.
#MAX_CLIENTS=0

# Keep a local transformer outside the checkout so updates do not overwrite it.
# The file must not be world-writable.
#TRANSFORMER=/etc/mjpeg-proxy/frame-transformer.js
